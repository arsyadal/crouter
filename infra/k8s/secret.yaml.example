apiVersion: v1
kind: Secret
metadata:
  name: crouter-secrets
  namespace: default
  labels:
    app: crouter-gateway
type: Opaque
stringData:
  database-url: "postgresql+asyncpg://crouter:crouter_secret@postgres:5432/crouter"
  redis-url: "redis://redis:6379/0"
  commandcode-api-key: "user_..."
  gemini-api-key: ""
  openrouter-api-key: ""
