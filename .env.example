# CRouter Environment Configuration (Zero-Budget Local Defaults)

# Server Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
DEBUG=false
ENVIRONMENT=development

# Database (PostgreSQL for Docker, SQLite supported for offline testing)
DATABASE_URL=postgresql+asyncpg://crouter:crouter_secret@localhost:5432/crouter_db
# For zero-dependency local run without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./crouter.db

# Cache & Limiter (Redis for distributed limits, memory fallback for offline testing)
REDIS_URL=redis://localhost:6379/0
REDIS_FALLBACK_IN_MEMORY=true

# Mock Provider Configuration (Zero Token Rp0)
MOCK_PROVIDER_URL=http://localhost:8001
MOCK_PROVIDER_PORT=8001

# Optional Live Providers (BYOK - Strictly optional, Rp0 by default)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Default Limits
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_MAX_CONCURRENCY=10
DEFAULT_REQUEST_TIMEOUT_MS=15000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30
